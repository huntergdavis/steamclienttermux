#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

base="$HOME/steam-arm64"
client_root="$base/client"
client="$client_root/steamrtarm64"
mesa="$base/mesa-kgsl"
mesa_lib="$mesa/usr/lib/aarch64-linux-gnu"
icd="$mesa/icd.d/freedreno-private.json"
steam_hosts="$base/config/hosts-ipv4"
arm_compat_template="$base/config/steam-arm64-compatibilitytools.vdf.in"
arm_runtime="$base/runtime/SteamLinuxRuntime_4-arm64"
arm_runtime_depot="$client_root/steamapps/common/SteamLinuxRuntime_4-arm64"
compat_bin="$base/compat-bin"
ui_patch="$base/patch-steam-network-ui.sh"
proc_net_prep="$base/prepare-proc-net-shadow.sh"
proc_net_shadow="$base/config/proc-net"
pressure_vessel_bwrap="$base/compat-bin/steam-arm64-bwrap-route"
real_pressure_vessel_bwrap="$arm_runtime/pressure-vessel/libexec/steam-runtime-tools-0/srt-bwrap"
steam_home="/root/steam-arm"
custom_proot_dir="$base/src/proot-production/src"
proot_patch_stamp="$base/src/proot-production/.steamclienttermux-patchset"
required_proot_patch="proot-runtime-directory-bind-target.patch"

command -v sha256sum >/dev/null || { echo 'sha256sum is required' >&2; exit 1; }

if [[ ! -x "$client/steam" ]]; then
    printf 'Steam ARM64 executable not found: %s\n' "$client/steam" >&2
    exit 1
fi
if [[ ! -f "$icd" ]]; then
    printf 'Private Turnip Vulkan ICD not found: %s\n' "$icd" >&2
    exit 1
fi
if [[ ! -f "$steam_hosts" ]]; then
    printf 'Private Steam hosts file not found: %s\n' "$steam_hosts" >&2
    exit 1
fi
if [[ ! -f "$arm_compat_template" ]]; then
    printf 'ARM64 compatibility-tool manifest template not found: %s\n' "$arm_compat_template" >&2
    exit 1
fi
if [[ ! -f "$arm_runtime/.steamclienttermux-runtime-shadow" ]] ||
        [[ ! -x "$arm_runtime/pressure-vessel/bin/pressure-vessel-wrap" ]]; then
    printf 'Prepared ARM64 runtime shadow not found: %s\n' "$arm_runtime" >&2
    printf 'Run scripts/prepare-arm64-runtime-shadow.sh before starting Steam.\n' >&2
    exit 1
fi
if find "$arm_runtime/pressure-vessel" -type l -lname '*/.l2s/*' -print -quit |
        grep -q .; then
    printf 'Prepared ARM64 runtime contains unsafe .l2s links: %s\n' "$arm_runtime" >&2
    exit 1
fi
if [[ ! -x "$custom_proot_dir/proot" ]]; then
    printf 'Required patched PRoot not found: %s\n' "$custom_proot_dir/proot" >&2
    printf 'Run scripts/build-proot.sh before starting Steam.\n' >&2
    exit 1
fi
if [[ ! -f "$proot_patch_stamp" ]] ||
        ! sed -n 's/^patches=//p' "$proot_patch_stamp" |
        tr ' ' '\n' | grep -Fxq "$required_proot_patch"; then
    printf 'Production PRoot lacks required patch: %s\n' \
        "$required_proot_patch" >&2
    printf 'Rebuild and deploy PRoot before starting Steam.\n' >&2
    exit 1
fi
stamped_proot="$(sed -n 's/^proot_sha256=//p' "$proot_patch_stamp")"
if [[ ! "$stamped_proot" =~ ^[0-9a-f]{64}$ ]] ||
        [[ "$(sha256sum "$custom_proot_dir/proot" | awk '{print $1}')" != "$stamped_proot" ]]; then
    printf 'Production PRoot does not match its build stamp: %s\n' \
        "$custom_proot_dir/proot" >&2
    printf 'Rebuild and deploy PRoot before starting Steam.\n' >&2
    exit 1
fi
if [[ ! -x "$compat_bin/lsof" ]]; then
    printf 'Steam compatibility lsof not found: %s\n' "$compat_bin/lsof" >&2
    exit 1
fi
if [[ ! -x "$ui_patch" ]]; then
    printf 'Steam UI compatibility patcher not found: %s\n' "$ui_patch" >&2
    exit 1
fi
if [[ ! -x "$proc_net_prep" ]]; then
    printf 'Synthetic /proc/net preparer not found: %s\n' "$proc_net_prep" >&2
    exit 1
fi
if [[ ! -x "$pressure_vessel_bwrap" ]]; then
    printf 'Pressure Vessel /proc/net wrapper not found: %s\n' \
        "$pressure_vessel_bwrap" >&2
    printf 'Run scripts/install-project-files.sh before starting Steam.\n' >&2
    exit 1
fi
if [[ ! -x "$real_pressure_vessel_bwrap" ]]; then
    printf 'ARM64 srt-bwrap not found: %s\n' \
        "$real_pressure_vessel_bwrap" >&2
    exit 1
fi

"$ui_patch"
"$proc_net_prep" "$base"
if [[ ! -f "$proc_net_shadow/route" ]] ||
        [[ ! -f "$proc_net_shadow/ipv6_route" ]]; then
    printf 'Synthetic /proc/net is incomplete: %s\n' "$proc_net_shadow" >&2
    exit 1
fi

mkdir -p "$base/logs"

# Steam's ARM64 CEF build can emit these debug streams continuously when its
# compatibility workarounds are active.  They have grown by tens of gigabytes
# in a single session, so discard only these two noisy files.  Normal Steam
# logs and our timestamped launcher log remain available under $base/logs.
noisy_logs=(
    "$client_root/logs/steamwebhelper.log"
    "$client_root/config/htmlcache/chrome_debug.log"
)
for noisy_log in "${noisy_logs[@]}"; do
    mkdir -p "$(dirname "$noisy_log")"
    if [[ -e "$noisy_log" && ! -L "$noisy_log" ]]; then
        truncate -s 0 -- "$noisy_log"
        rm -f -- "$noisy_log"
    fi
    ln -sfn /dev/null "$noisy_log"
done

pulseaudio --check >/dev/null 2>&1 || pulseaudio --start --exit-idle-time=-1
pactl load-module module-native-protocol-tcp \
    auth-ip-acl=127.0.0.1 auth-anonymous=1 >/dev/null 2>&1 || true

display="${DISPLAY:-:0}"
log="$base/logs/steam-$(date +%Y%m%d-%H%M%S).log"
# Keep the patched PRoot crash tracer enabled for unattended/menu launches.
# This is diagnostic only and has no effect unless a translated process fails.
export PROOT_CRASH_LOG="${PROOT_CRASH_LOG:-1}"

# Steam otherwise autolaunches D-Bus from its updater process.  The spawned
# daemon inherits the updater IPC pipe and prevents EOF for about five minutes.
# Create a private session first, with its diagnostic descriptors isolated.
dbus_runtime="$base/run/dbus"
mkdir -p "$dbus_runtime"
dbus_address_file="$dbus_runtime/address.$$"
dbus_pid_file="$dbus_runtime/pid.$$"
dbus-daemon --session --fork \
    --print-address=3 --print-pid=4 \
    3>"$dbus_address_file" 4>"$dbus_pid_file" </dev/null 2>/dev/null
dbus_address="$(<"$dbus_address_file")"
dbus_pid="$(<"$dbus_pid_file")"
if [[ -z "$dbus_address" || ! "$dbus_pid" =~ ^[0-9]+$ ]]; then
    printf 'Failed to start private Steam D-Bus session\n' >&2
    exit 1
fi

cleanup_dbus() {
    if [[ "$dbus_pid" =~ ^[0-9]+$ ]] && kill -0 "$dbus_pid" 2>/dev/null; then
        dbus_cmdline="$(tr '\0' ' ' <"/proc/$dbus_pid/cmdline" 2>/dev/null || true)"
        if [[ "$dbus_cmdline" == *dbus-daemon* ]]; then
            kill "$dbus_pid" 2>/dev/null || true
        fi
    fi
    rm -f -- "$dbus_address_file" "$dbus_pid_file"
}
trap cleanup_dbus EXIT

printf 'Starting native ARM64 Steam on DISPLAY=%s\nLog: %s\n' "$display" "$log"

pd_args=(login debian --shared-tmp)
pd_args+=(--bind "$steam_hosts:/etc/hosts")
# Android denies the Termux UID access to /proc/net/route. Proton Wine turns
# that denial into GetAdaptersAddresses error 50, leaving NLM disconnected even
# while sockets work. Expose only a validated route snapshot in a private
# /proc/net shadow; the Android-protected directory has no usable entries for
# this process otherwise.
pd_args+=(--bind "$proc_net_shadow:/proc/net")
# Bubblewrap's --proc mount covers the outer bind above. Re-inject the same
# validated directory afterward so Proton/Wine retain network-adapter state
# inside Pressure Vessel. The matching PRoot patch keeps the literal /proc/net
# mount point instead of dereferencing it to a process-specific PID path.
pd_args+=(--env "PRESSURE_VESSEL_BWRAP=$pressure_vessel_bwrap")
pd_args+=(--env "STEAM_ARM64_REAL_BWRAP=$real_pressure_vessel_bwrap")
pd_args+=(--env "STEAM_ARM64_PROC_NET=$proc_net_shadow")
# Steam resolves Proton's numeric require_tool_appid through the installed App
# ID directory, ignoring a local tool's alternate install_path. Overlay only
# that expected guest directory with the prepared shadow. The official depot
# and appmanifest remain untouched on the host.
pd_args+=(--bind "$arm_runtime:$arm_runtime_depot")
pd_args+=(--env "DBUS_SESSION_BUS_ADDRESS=$dbus_address")
if [[ -n "${PROOT_SYSVIPC_LOG:-}" ]]; then
    pd_args+=(--env "PROOT_SYSVIPC_LOG=$PROOT_SYSVIPC_LOG")
fi
if [[ -n "${PROOT_VERBOSE:-}" ]]; then
    pd_args+=(--env "PROOT_VERBOSE=$PROOT_VERBOSE")
fi
if [[ -n "${PROOT_CRASH_LOG:-}" ]]; then
    pd_args+=(--env "PROOT_CRASH_LOG=$PROOT_CRASH_LOG")
fi
# Pressure Vessel normally hard-links every mutable-runtime file. PRoot's
# link2symlink representation is unsuitable as a Bubblewrap bind source, so
# the patched PRoot returns EXDEV only for this exact private tmp- prefix and
# lets Pressure Vessel use its normal copy fallback. Use the guest-visible
# depot spelling; the outer bind translates it to the shadow on the host.
export PROOT_L2S_EXDEV_PREFIX="$arm_runtime_depot/var/tmp-"
pd_args+=(--env "PROOT_L2S_EXDEV_PREFIX=$PROOT_L2S_EXDEV_PREFIX")

export PATH="$custom_proot_dir:$PATH"

proot-distro "${pd_args[@]}" -- /bin/bash -lc '
    set -eo pipefail
    mkdir -p "$1/.steam" "$6/compatibilitytools.d/steam-arm64-official" /tmp/steam-runtime
    ln -sfn "$6" "$1/.steam/steam"
    # The ARM client refers to these through the traditional $HOME/.steam
    # SDK layout.  Keep .steam as a real directory because Steam stores live
    # state there, and expose only the client directories it expects.
    ln -sfn "$6/linuxarm64" "$1/.steam/sdkarm64"
    ln -sfn "$6/steamrt64" "$1/.steam/bin64"
    ln -sfn "$6/steamrt32" "$1/.steam/bin32"
    ln -sfn "$6/steamrtarm64" "$1/.steam/steamrtarm64"
    # SteamPlay 2.0 Manifests (App ID 891390) can omit the separately
    # distributed ARM64 Proton and runtime App IDs.  Register the untouched
    # official payloads through the supported local-tool manifest path.
    # The template gives them explicit local keys and preserves their App IDs
    # so the require_tool_appid=4185400 dependency resolves to ARM64.
    arm_compat_manifest="$6/compatibilitytools.d/steam-arm64-official/compatibilitytool.vdf"
    # Forwarded steam:// commands also enter this launcher. Avoid replacing an
    # identical manifest: changing only its mtime makes Steam rebuild the
    # compatibility-tool registry, which is exceptionally slow through PRoot.
    if sed "s|@CLIENT_ROOT@|$6|g" "$8" | cmp -s - "$arm_compat_manifest"; then
        :
    else
        arm_compat_manifest_tmp="$(mktemp "$arm_compat_manifest.tmp.XXXXXX")"
        if ! sed "s|@CLIENT_ROOT@|$6|g" "$8" >"$arm_compat_manifest_tmp"; then
            unlink -- "$arm_compat_manifest_tmp"
            exit 1
        fi
        mv "$arm_compat_manifest_tmp" "$arm_compat_manifest"
    fi
    chmod 700 /tmp/steam-runtime
    export HOME="$1"
    export DISPLAY="$2"
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export XDG_RUNTIME_DIR=/tmp/steam-runtime
    export PULSE_SERVER=127.0.0.1
    export LD_LIBRARY_PATH="$3"
    export VK_DRIVER_FILES="$4"
    export LIBGL_DRIVERS_PATH="$3/dri"
    export MESA_LOADER_DRIVER_OVERRIDE=kgsl
    export TU_DEBUG=noconform
    export MESA_VK_WSI_PRESENT_MODE=mailbox
    export PATH="$7:$PATH"
    steam_exe="$5"
    cd "$6"
    shift 8
    # CEF GPU compositing produces stale/partial X11 surfaces under
    # Termux:X11. This affects only the Steam HTML UI; games retain Turnip.
    # Avoid Steam file-by-file preallocation through PRoot. The operation is
    # pathologically slow under ptrace and can hold downloads at 2 percent.
    exec "$steam_exe" -no-cef-sandbox -cef-disable-gpu -chromeosnopreallocate -noverifyfiles "$@"
' steam-arm "$steam_home" "$display" "$mesa_lib" "$icd" "$client/steam" "$client_root" "$compat_bin" "$arm_compat_template" "$@" \
    2>&1 | tee "$log"
