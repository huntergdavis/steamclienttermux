#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail
umask 077

base=${STEAM_ARM64_BASE:-$HOME/steam-arm64}
client_root=$base/client
client=$client_root/steamrtarm64
mesa_lib=$base/mesa-kgsl/usr/lib/aarch64-linux-gnu
icd=$base/mesa-kgsl/icd.d/freedreno-private.json
compat_bin=$base/compat-bin
native_home=$base/native-home
runtime_dir=$base/run/native-steam
crash_dir=$runtime_dir/dumps
compat_repo=${TGCOMPAT_REPO:-$HOME/workspace/termux-glibc-compat}
candidate_selector=${TGCOMPAT_GLIBC_ROOT:-$HOME/.local/share/tgcompat/glibc/current}
exec_shim=${TGCOMPAT_EXEC_SHIM:-$compat_repo/build/libtgcompat-exec.so}
tmp_shim=${STEAM_ARM64_TMP_SHIM:-$compat_bin/steam-arm64-native-tmp.so}
linux_root_selector=${STEAM_ARM64_NATIVE_ROOTFS:-$PREFIX/var/lib/proot-distro/containers/debian/rootfs}
session_tool=$compat_repo/scripts/tgcompat-session.sh
termux_exec_hook=${TERMUX_EXEC_GLIBC:-$PREFIX/glibc/lib/libtermux-exec.so}
session_guard=$compat_bin/steam-arm64-session-guard.py
arm_compat_template=$base/config/steam-arm64-compatibilitytools.vdf.in
arm_runtime=$base/runtime/SteamLinuxRuntime_4-arm64
arm_runtime_depot=$client_root/steamapps/common/SteamLinuxRuntime_4-arm64
native_runtime=$base/runtime/SteamLinuxRuntime_4-arm64-native
native_bwrap=$compat_bin/steam-arm64-native-bwrap-entry
native_bwrap_script=$compat_bin/steam-arm64-native-bwrap
proc_net_prep=$base/prepare-proc-net-shadow.sh
proc_net_shadow=$base/config/proc-net
steam_hosts=$base/config/hosts-ipv4
removable_library_helper=$compat_bin/steam-arm64-removable-library.py
runtime_direct_prep=$base/prepare-runtime-direct-run.sh
runtime_direct_run=$base/config/steamlinuxruntime4-run-direct
runtime_root_prep=$compat_bin/prepare-runtime-direct-root.py
custom_proot_dir=${STEAM_ARM64_PROOT_DIR:-$base/src/proot-production/src}
proot_binary=$custom_proot_dir/proot
proot_patch_stamp=${custom_proot_dir%/src}/.steamclienttermux-patchset
required_proot_patch=proot-runtime-directory-bind-target.patch
ui_patch=$base/patch-steam-network-ui.sh
pulse_prep=$base/prepare-pulseaudio-tcp.sh
display=${DISPLAY:-:0}

fail() {
    printf 'steam-arm-native: %s\n' "$*" >&2
    exit 1
}

for command in realpath stat sha256sum python3 dbus-daemon bash grep; do
    command -v "$command" >/dev/null 2>&1 ||
        fail "required command is missing: $command"
done
[[ -n ${PREFIX:-} && $PREFIX == /* ]] || fail 'PREFIX must be an absolute path'
[[ $display =~ ^:[0-9]+$ ]] || fail "invalid X display: $display"
[[ -x $client/steam ]] || fail "Steam ARM64 executable is missing: $client/steam"
[[ -d $client/libs && -d $client_root/linuxarm64 ]] ||
    fail "Steam ARM64 runtime directories are incomplete: $client"
[[ -d $mesa_lib && -f $icd ]] || fail "Turnip/Mesa runtime is incomplete: $base/mesa-kgsl"
[[ -x $exec_shim && ! -L $exec_shim ]] ||
    fail "glibc exec shim is missing: $exec_shim"
grep -aFq 'TGCOMPAT_PROC_SELF_EXE' "$exec_shim" ||
    fail "glibc exec shim cannot preserve /proc/self/exe: $exec_shim"
[[ -f $tmp_shim && ! -L $tmp_shim ]] ||
    fail "native /tmp shim is missing: $tmp_shim"
[[ -x $session_tool && -x $compat_repo/build/tgcompatd ]] ||
    fail "native semaphore broker is not built: $compat_repo"
[[ -f $termux_exec_hook && ! -L $termux_exec_hook ]] ||
    fail "termux-exec-glibc hook is missing: $termux_exec_hook"
[[ -f $session_guard && -x $ui_patch && -x $pulse_prep ]] ||
    fail 'installed steamclienttermux helpers are incomplete'
[[ -f $arm_compat_template ]] ||
    fail "ARM64 compatibility-tool template is missing: $arm_compat_template"
[[ -x $native_bwrap && ! -L $native_bwrap && -x $native_bwrap_script &&
        ! -L $native_bwrap_script && -x $proc_net_prep &&
        -x $runtime_direct_prep && -f $runtime_root_prep &&
        -f $steam_hosts &&
        -f $removable_library_helper &&
        -f $arm_runtime/.steamclienttermux-runtime-shadow &&
        -x $arm_runtime/pressure-vessel/bin/pressure-vessel-wrap &&
        -d $arm_runtime_depot && -x $native_runtime/_v2-entry-point &&
        ! -L $native_runtime/_v2-entry-point ]] ||
    fail 'native game-boundary helpers or ARM64 runtime are incomplete'
[[ -x $proot_binary && ! -L $proot_binary && -f $proot_patch_stamp &&
        ! -L $proot_patch_stamp ]] ||
    fail 'patched game-boundary PRoot or its stamp is unavailable'
sed -n 's/^patches=//p' "$proot_patch_stamp" | tr ' ' '\n' |
    grep -Fxq "$required_proot_patch" ||
    fail "game-boundary PRoot lacks $required_proot_patch"
stamped_proot=$(sed -n 's/^proot_sha256=//p' "$proot_patch_stamp")
[[ $stamped_proot =~ ^[0-9a-f]{64}$ &&
        $(sha256sum "$proot_binary" | awk '{print $1}') == "$stamped_proot" ]] ||
    fail 'game-boundary PRoot does not match its build stamp'

candidate_root=$(realpath -e "$candidate_selector") ||
    fail "staged glibc selector is unavailable: $candidate_selector"
home_root=$(realpath -e "$HOME")
[[ $candidate_root == "$home_root"/* && -d $candidate_root &&
        ! -L $candidate_root ]] ||
    fail "staged glibc resolves outside HOME or is unsafe: $candidate_root"
loader=$candidate_root/lib/ld-linux-aarch64.so.1
candidate_lib=$candidate_root/lib
marker=$candidate_root/.tgcompat-package-sha256
[[ -x $loader && ! -L $loader && -f $candidate_lib/libc.so.6 &&
        ! -L $candidate_lib/libc.so.6 && -f $marker && ! -L $marker ]] ||
    fail "staged glibc is not validated: $candidate_root"
read -r package_sha < "$marker"
[[ $package_sha =~ ^[0-9a-f]{64}$ ]] ||
    fail "staged glibc marker is invalid: $marker"

linux_root=$(realpath -e "$linux_root_selector") ||
    fail "Linux runtime root is unavailable: $linux_root_selector"
[[ -d $linux_root && ! -L $linux_root ]] ||
    fail "Linux runtime root is unsafe: $linux_root"
linux_lib=$linux_root/usr/lib/aarch64-linux-gnu
linux_pulse_lib=$linux_lib/pulseaudio
linux_usr_lib=$linux_root/usr/lib
ssl_cert_file=$linux_root/etc/ssl/certs/ca-certificates.crt
ssl_cert_dir=$linux_root/etc/ssl/certs
fontconfig_file=$linux_root/etc/fonts/fonts.conf
fontconfig_path=$linux_root/etc/fonts
[[ -d $linux_lib && ! -L $linux_lib ]] ||
    fail "Linux ARM64 runtime libraries are missing: $linux_lib"
[[ -d $linux_pulse_lib && ! -L $linux_pulse_lib ]] ||
    fail "Linux PulseAudio private libraries are missing: $linux_pulse_lib"
[[ -f $ssl_cert_file && ! -L $ssl_cert_file && -d $ssl_cert_dir &&
        ! -L $ssl_cert_dir ]] ||
    fail "Linux TLS certificate store is missing: $ssl_cert_dir"
[[ -f $fontconfig_file && ! -L $fontconfig_file && -d $fontconfig_path &&
        ! -L $fontconfig_path ]] ||
    fail "Linux Fontconfig configuration is missing: $fontconfig_path"

# The staged package deliberately supplies only the patched glibc core. Reuse
# the already-installed Debian runtime libraries by their real host paths;
# reading them directly does not put Steam under PRoot or its ptrace tracer.
# Put the candidate libc first, Steam's private DSOs second, Turnip third, and
# the coherent Debian dependency set last. Avoid the active Termux-glibc tree,
# so one process cannot accidentally mix two libc package revisions.
library_path=$candidate_lib:$client:$client/libs:$client_root/linuxarm64:$mesa_lib:$linux_lib:$linux_pulse_lib:$linux_usr_lib

check_dependencies() {
    local executable=$1 label=$2 output
    if ! output=$(env -u LD_PRELOAD -u LD_LIBRARY_PATH \
            -u GLIBC_LD_LIBRARY_PATH \
            "$loader" --inhibit-cache --library-path "$library_path" \
            --list "$executable" 2>&1); then
        printf '%s\n' "$output" >&2
        fail "$label dependency audit failed"
    fi
    if grep -Fq 'not found' <<<"$output"; then
        printf '%s\n' "$output" >&2
        fail "$label has unresolved dependencies"
    fi
}

check_dependencies "$client/steam" 'Steam bootstrap'
check_dependencies "$client/steamwebhelper" 'Steam web helper'
check_dependencies "$client/steamui.so" 'Steam UI'

if [[ ${STEAM_ARM64_NATIVE_CHECK:-0} == 1 ]]; then
    [[ -x $runtime_direct_run && ! -L $runtime_direct_run ]] ||
        fail "direct Runtime 4 policy is unavailable: $runtime_direct_run"
    STEAM_ARM64_BASE="$base" STEAM_ARM64_NATIVE_BWRAP_CHECK=1 \
        "$native_bwrap_script" >/dev/null
    printf 'candidate_sha256=%s\n' "$package_sha"
    printf 'candidate_loader=%s\n' "$loader"
    printf 'exec_shim=%s\n' "$exec_shim"
    printf 'linux_runtime=%s\n' "$linux_root"
    printf 'steam=%s\n' "$client/steam"
    printf '%s\n' 'native Steam dependency preflight: PASS'
    exit 0
fi

steam_running=no
if pgrep -f 'steamrtarm64[/]steam' >/dev/null 2>&1; then
    steam_running=yes
else
    pgrep_status=$?
    ((pgrep_status == 1)) || fail "unable to inspect Steam processes: $pgrep_status"
fi
python3 "$session_guard" preflight \
    --client-root "$client_root" \
    --logs-dir "$base/logs" \
    --min-free-bytes "${STEAM_ARM64_MIN_FREE_BYTES:-1073741824}" \
    --log-cap-bytes "${STEAM_ARM64_SESSION_LOG_CAP_BYTES:-67108864}" \
    --stdout-cap-bytes "${STEAM_ARM64_STDOUT_CAP_BYTES:-1048576}" \
    --steam-running "$steam_running"

"$ui_patch"
"$pulse_prep" "$base"
"$proc_net_prep" "$base"
python3 "$runtime_root_prep" --base "$base"
"$runtime_direct_prep" "$base"
[[ ! -L $native_home && ! -L $native_home/.steam && ! -L $runtime_dir &&
        ! -L $crash_dir ]] ||
    fail 'native HOME/runtime paths cannot be symbolic links'
install -d -m 0700 -- \
    "$native_home" "$native_home/.steam" "$runtime_dir" "$crash_dir"

ensure_link() {
    local target=$1 link=$2
    if [[ -L $link ]]; then
        [[ $(readlink -- "$link") == "$target" ]] ||
            fail "native HOME link has an unexpected target: $link"
        return
    fi
    [[ ! -e $link ]] || fail "native HOME link target already exists: $link"
    ln -s -- "$target" "$link"
}

ensure_link "$client_root" "$native_home/.steam/steam"
ensure_link "$client_root/linuxarm64" "$native_home/.steam/sdkarm64"
ensure_link "$client_root/steamrt64" "$native_home/.steam/bin64"
ensure_link "$client_root/steamrt32" "$native_home/.steam/bin32"
ensure_link "$client" "$native_home/.steam/steamrtarm64"

manifest_dir=$client_root/compatibilitytools.d/steam-arm64-official
manifest=$manifest_dir/compatibilitytool.vdf
install -d -m 0700 -- "$manifest_dir"
manifest_stage=$(mktemp "$manifest.tmp.XXXXXX")
cleanup_manifest_stage() {
    if [[ -n ${manifest_stage:-} && -f $manifest_stage &&
            ! -L $manifest_stage ]]; then
        rm -- "$manifest_stage"
    fi
}
trap cleanup_manifest_stage EXIT
sed -e "s|@CLIENT_ROOT@|$client_root|g" \
    -e "s|@RUNTIME_ROOT@|$native_runtime|g" \
    "$arm_compat_template" > "$manifest_stage"
if [[ -f $manifest && ! -L $manifest ]] && cmp -s "$manifest_stage" "$manifest"; then
    rm -- "$manifest_stage"
else
    mv -- "$manifest_stage" "$manifest"
fi
manifest_stage=

if ! bash "$session_tool" status >/dev/null 2>&1; then
    bash "$session_tool" start
fi
if [[ -n ${TGCOMPAT_SOCKET:-} ]]; then
    socket_path=$TGCOMPAT_SOCKET
else
    socket_path=${TMPDIR:-/tmp}/tgcompat-$(id -u)/broker.sock
fi
[[ -S $socket_path ]] || fail "broker socket is unavailable: $socket_path"

dbus_address_file=$runtime_dir/dbus-address.$$
dbus_pid_file=$runtime_dir/dbus-pid.$$
dbus_pid=

cleanup() {
    cleanup_manifest_stage
    if [[ ${dbus_pid:-} =~ ^[1-9][0-9]*$ ]] &&
            kill -0 "$dbus_pid" 2>/dev/null; then
        dbus_command=$(tr '\0' ' ' < "/proc/$dbus_pid/cmdline" 2>/dev/null || true)
        if [[ $dbus_command == *dbus-daemon* ]]; then
            kill "$dbus_pid" 2>/dev/null || true
        fi
    fi
    rm -f -- "$dbus_address_file" "$dbus_pid_file"
}
trap cleanup EXIT

dbus-daemon --session --fork --print-address=3 --print-pid=4 \
    3>"$dbus_address_file" 4>"$dbus_pid_file" </dev/null 2>/dev/null
dbus_address=$(<"$dbus_address_file")
dbus_pid=$(<"$dbus_pid_file")
[[ -n $dbus_address && $dbus_pid =~ ^[1-9][0-9]*$ ]] ||
    fail 'unable to start the private Steam D-Bus session'

preload=$tmp_shim:$exec_shim:$termux_exec_hook
log=$(python3 "$session_guard" create-log --logs-dir "$base/logs")

removable_mount=$(python3 "$removable_library_helper" --base "$base" mount-info)
declare -a removable_environment=()
if [[ $removable_mount != disabled ]]; then
    IFS=$'\t' read -r removable_source removable_target \
        removable_steamapps removable_common removable_compatdata \
        removable_downloads removable_extra <<<"$removable_mount"
    [[ -n $removable_source && -n $removable_target &&
            -n $removable_steamapps && -n $removable_common &&
            -n $removable_compatdata && -n $removable_downloads &&
            -z ${removable_extra:-} ]] ||
        fail 'invalid removable-library mount description'
    removable_environment+=(
        "STEAM_ARM64_REMOVABLE_SOURCE=$removable_source"
        "STEAM_ARM64_REMOVABLE_TARGET=$removable_target"
        "STEAM_ARM64_REMOVABLE_STEAMAPPS=$removable_steamapps"
        "STEAM_ARM64_REMOVABLE_COMMON=$removable_common"
        "STEAM_ARM64_REMOVABLE_COMPATDATA=$removable_compatdata"
        "STEAM_ARM64_REMOVABLE_DOWNLOADS=$removable_downloads"
    )
fi
fex_profile=${STEAM_ARM64_FEX_PROFILE:-safe}
fex_profile_env=()
case $fex_profile in
    proton)
        ;;
    safe|fast)
        fex_profile_env+=(
            FEX_MAXINST=5000
            FEX_PROFILESTATS=0
            FEX_DISABLEL2CACHE=0
            FEX_DYNAMICL1CACHE=0
            FEX_X87REDUCEDPRECISION=1
            FEX_MULTIBLOCK=1
            FEX_VECTORTSOENABLED=0
            FEX_MEMCPYSETTSOENABLED=0
            FEX_SMALLTSCSCALE=1
            FEX_SMC_CHECKS=mtrack
            FEX_VOLATILEMETADATA=1
            FEX_MONOHACKS=1
            FEX_HIDEHYPERVISORBIT=0
            STEAM_FEX_MULTIBLOCK=1
        )
        if [[ $fex_profile == fast ]]; then
            fex_profile_env+=(
                FEX_TSOENABLED=0
                FEX_HALFBARRIERTSOENABLED=0
                STEAM_FEX_TSOENABLED=0
            )
        else
            fex_profile_env+=(
                FEX_TSOENABLED=1
                FEX_HALFBARRIERTSOENABLED=1
                STEAM_FEX_TSOENABLED=1
            )
        fi
        ;;
    *)
        fail "STEAM_ARM64_FEX_PROFILE must be proton, safe, or fast: $fex_profile"
        ;;
esac

printf 'Starting no-PRoot ARM64 Steam on DISPLAY=%s (FEX %s)\nLog: %s\n' \
    "$display" "$fex_profile" "$log"
cd "$client_root"
set +e
env -u GLIBC_LD_LIBRARY_PATH \
    "${fex_profile_env[@]}" \
    "${removable_environment[@]}" \
    STEAM_ARM64_BASE="$base" \
    HOME="$native_home" \
    DISPLAY="$display" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TMPDIR="$PREFIX/tmp" \
    SSL_CERT_FILE="$ssl_cert_file" \
    SSL_CERT_DIR="$ssl_cert_dir" \
    FONTCONFIG_FILE="$fontconfig_file" \
    FONTCONFIG_PATH="$fontconfig_path" \
    FONTCONFIG_SYSROOT="$linux_root" \
    STEAM_ARM64_TMP_ROOT="$PREFIX/tmp" \
    STEAM_ARM64_LINUX_ROOT="$linux_root" \
    TGCOMPAT_PROC_SELF_EXE="$client/steam" \
    BREAKPAD_DUMP_LOCATION="$crash_dir" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    PULSE_SERVER="${PULSE_SERVER:-tcp:127.0.0.1:4713}" \
    DBUS_SESSION_BUS_ADDRESS="$dbus_address" \
    PRESSURE_VESSEL_BWRAP="$native_bwrap" \
    STEAM_ARM64_PROC_NET="$proc_net_shadow" \
    LD_PRELOAD="$preload" \
    LD_LIBRARY_PATH="$library_path" \
    TGCOMPAT_SOCKET="$socket_path" \
    TGCOMPAT_LD_SO="$loader" \
    TGCOMPAT_LIBRARY_PATH="$library_path" \
    STEAM_COMPAT_CLIENT_INSTALL_PATH="$client_root" \
    VK_DRIVER_FILES="$icd" \
    LIBGL_DRIVERS_PATH="$mesa_lib/dri" \
    MESA_LOADER_DRIVER_OVERRIDE=kgsl \
    TU_DEBUG=noconform \
    MESA_VK_WSI_PRESENT_MODE=mailbox \
    PATH="$PREFIX/glibc/bin:$compat_bin:$PATH" \
    "$loader" --inhibit-cache --library-path "$library_path" \
        --argv0 "$client/steam" "$client/steam" \
        -no-cef-sandbox -cef-disable-gpu -chromeosnopreallocate \
        -noverifyfiles "$@" 2>&1 |
    env -u LD_PRELOAD -u LD_LIBRARY_PATH -u GLIBC_LD_LIBRARY_PATH \
        python3 "$session_guard" stream \
            --log "$log" \
            --log-cap-bytes "${STEAM_ARM64_SESSION_LOG_CAP_BYTES:-67108864}" \
            --stdout-cap-bytes "${STEAM_ARM64_STDOUT_CAP_BYTES:-1048576}"
steam_status=${PIPESTATUS[0]}
set -e
exit "$steam_status"
