#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail
umask 077

base=${STEAM_ARM64_BASE:-$HOME/steam-arm64}
client_root=$base/client
native_home=$base/native-home
runtime_shadow=$base/runtime/SteamLinuxRuntime_4-arm64
runtime_depot=$client_root/steamapps/common/SteamLinuxRuntime_4-arm64
compat_bin=$base/compat-bin
route=$compat_bin/steam-arm64-bwrap-route
real_bwrap=$runtime_shadow/pressure-vessel/libexec/steam-runtime-tools-0/srt-bwrap
proc_net=$base/config/proc-net
hosts=$base/config/hosts-ipv4
custom_proot_dir=${STEAM_ARM64_PROOT_DIR:-$base/src/proot-production/src}
proot_binary=$custom_proot_dir/proot
proot_patch_stamp=${custom_proot_dir%/src}/.steamclienttermux-patchset
required_proot_patch=proot-runtime-directory-bind-target.patch
proot_distro=${PREFIX:-}/bin/proot-distro
mesa_lib=$base/mesa-kgsl/usr/lib/aarch64-linux-gnu
host_vk_driver_files=$base/mesa-kgsl/icd.d/freedreno-private.json
bridge_mode=${STEAM_ARM64_NATIVE_BRIDGE_MODE:-bwrap}
runtime_direct=${STEAM_ARM64_RUNTIME_DIRECT:-1}
direct_run=$base/config/steamlinuxruntime4-run-direct
guest_env=/usr/bin/env

fail() {
    printf 'steam-arm64-native-bwrap: %s\n' "$*" >&2
    exit 125
}

[[ -n ${PREFIX:-} && $PREFIX == /* ]] || fail 'PREFIX must be absolute'
[[ -x $proot_binary && ! -L $proot_binary ]] ||
    fail "patched PRoot is unavailable: $proot_binary"
[[ -f $proot_patch_stamp && ! -L $proot_patch_stamp ]] ||
    fail "patched PRoot stamp is unavailable: $proot_patch_stamp"
sed -n 's/^patches=//p' "$proot_patch_stamp" | tr ' ' '\n' |
    grep -Fxq "$required_proot_patch" ||
    fail "patched PRoot lacks $required_proot_patch"
stamped_proot=$(sed -n 's/^proot_sha256=//p' "$proot_patch_stamp")
[[ $stamped_proot =~ ^[0-9a-f]{64}$ &&
        $(sha256sum "$proot_binary" | awk '{print $1}') == "$stamped_proot" ]] ||
    fail "patched PRoot does not match its build stamp: $proot_binary"
[[ -x $proot_distro && ! -L $proot_distro ]] ||
    fail "proot-distro is unavailable: $proot_distro"
[[ -d $native_home && ! -L $native_home &&
        -d $native_home/.steam && ! -L $native_home/.steam ]] ||
    fail "native Steam HOME is unavailable or redirected: $native_home"
sdk_link=$native_home/.steam/sdkarm64
[[ -L $sdk_link ]] ||
    fail 'native Steam ARM64 SDK link is unavailable or redirected'
sdk_target=$(readlink -- "$sdk_link") ||
    fail 'native Steam ARM64 SDK link cannot be read'
[[ $sdk_target == "$client_root/linuxarm64" ]] ||
    fail 'native Steam ARM64 SDK link is unavailable or redirected'
[[ -x $route && ! -L $route ]] || fail "bwrap route is unavailable: $route"
[[ -x $real_bwrap && ! -L $real_bwrap ]] ||
    fail "real ARM64 srt-bwrap is unavailable: $real_bwrap"
[[ -f $runtime_shadow/.steamclienttermux-runtime-shadow &&
        -x $runtime_shadow/_v2-entry-point &&
        -d $runtime_depot && ! -L $runtime_shadow && ! -L $runtime_depot ]] ||
    fail 'ARM64 runtime shadow or official depot is unsafe/incomplete'
[[ -f $hosts && ! -L $hosts && -f $proc_net/route &&
        ! -L $proc_net/route && -f $proc_net/ipv6_route &&
        ! -L $proc_net/ipv6_route ]] ||
    fail 'validated hosts or /proc/net shadow is unavailable'
[[ -d $mesa_lib && ! -L $mesa_lib ]] ||
    fail "Mesa library directory is unavailable: $mesa_lib"
[[ -f $host_vk_driver_files && ! -L $host_vk_driver_files &&
        -s $host_vk_driver_files ]] ||
    fail "private Vulkan ICD is unavailable: $host_vk_driver_files"
[[ $(stat -c %u -- "$host_vk_driver_files") == $(id -u) ]] ||
    fail 'private Vulkan ICD has an unexpected owner'
icd_mode=$(stat -c %a -- "$host_vk_driver_files")
[[ $icd_mode =~ ^[0-7]{3,4}$ ]] || fail 'private Vulkan ICD has an invalid mode'
(( (8#$icd_mode & 0022) == 0 )) ||
    fail 'private Vulkan ICD must not be group- or other-writable'
[[ $runtime_direct == 0 || $runtime_direct == 1 ]] ||
    fail 'STEAM_ARM64_RUNTIME_DIRECT must be 0 or 1'
if [[ $runtime_direct == 1 ]]; then
    [[ -x $direct_run && ! -L $direct_run ]] ||
        fail "direct Runtime 4 policy is unavailable: $direct_run"
fi
case $bridge_mode in
    runtime|bwrap)
        ;;
    *)
        fail "invalid native bridge mode: $bridge_mode"
        ;;
esac

if [[ ${STEAM_ARM64_NATIVE_BWRAP_CHECK:-0} == 1 ]]; then
    printf 'mode=%s\nruntime_direct=%s\nproot=%s\nroute=%s\nreal_bwrap=%s\nruntime_shadow=%s\n' \
        "$bridge_mode" "$runtime_direct" "$proot_binary" "$route" \
        "$real_bwrap" "$runtime_shadow"
    printf '%s\n' 'native game boundary preflight: PASS'
    exit 0
fi

(( $# > 0 )) || fail 'srt-bwrap arguments are required'

launch_work_dir=$(pwd -P) || fail 'cannot resolve launch working directory'
[[ $launch_work_dir == /* ]] || fail 'launch working directory must be absolute'
bridge_work_dir=$launch_work_dir

declare -a pd_args=(login debian --shared-tmp)
pd_args+=(--bind "$hosts:/etc/hosts")
pd_args+=(--bind "$proc_net:/proc/net")
pd_args+=(--bind "$runtime_shadow:$runtime_depot")
if [[ $runtime_direct == 1 ]]; then
    pd_args+=(--bind "$direct_run:$runtime_depot/run")
fi

if [[ -n ${STEAM_ARM64_REMOVABLE_SOURCE:-} ]]; then
    for name in STEAM_ARM64_REMOVABLE_SOURCE STEAM_ARM64_REMOVABLE_TARGET \
            STEAM_ARM64_REMOVABLE_STEAMAPPS STEAM_ARM64_REMOVABLE_COMMON \
            STEAM_ARM64_REMOVABLE_COMPATDATA STEAM_ARM64_REMOVABLE_DOWNLOADS; do
        [[ ${!name:-} == /* && ${!name} != / && ${!name} != */ ]] ||
            fail "invalid removable mount variable: $name"
    done
    pd_args+=(--bind \
        "$STEAM_ARM64_REMOVABLE_SOURCE:$STEAM_ARM64_REMOVABLE_TARGET")
    pd_args+=(--bind \
        "$STEAM_ARM64_REMOVABLE_STEAMAPPS:$STEAM_ARM64_REMOVABLE_TARGET/steamapps")
    pd_args+=(--bind \
        "$STEAM_ARM64_REMOVABLE_COMMON:$STEAM_ARM64_REMOVABLE_TARGET/steamapps/common")
    pd_args+=(--bind \
        "$STEAM_ARM64_REMOVABLE_COMPATDATA:$STEAM_ARM64_REMOVABLE_TARGET/steamapps/compatdata")
    pd_args+=(--bind \
        "$STEAM_ARM64_REMOVABLE_DOWNLOADS:$STEAM_ARM64_REMOVABLE_TARGET/steamapps/downloading")

    # Steam changes into the physical game directory before invoking this
    # wrapper.  Translate that directory along with the executable arguments,
    # otherwise proot-distro starts the guest in /root and Windows games cannot
    # open relative data files from the protected removable-library view.
    case $bridge_work_dir in
        "$STEAM_ARM64_REMOVABLE_SOURCE")
            bridge_work_dir=$STEAM_ARM64_REMOVABLE_TARGET
            ;;
        "$STEAM_ARM64_REMOVABLE_SOURCE"/*)
            work_dir_suffix=${bridge_work_dir#"$STEAM_ARM64_REMOVABLE_SOURCE"}
            bridge_work_dir=$STEAM_ARM64_REMOVABLE_TARGET$work_dir_suffix
            ;;
    esac
fi
pd_args+=(--work-dir "$bridge_work_dir")

declare -a bridge_arguments=("$@")
if [[ -n ${STEAM_ARM64_REMOVABLE_SOURCE:-} ]]; then
    # Native Steam records the physical SD-card install path.  PRoot exposes
    # that library at the protected removable target instead, and Proton's
    # steam.exe crashes in wcslen(NULL) when wine_get_dos_file_name() cannot
    # resolve the untranslated /storage path.  Rewrite only exact source-path
    # arguments and descendants; similarly named paths remain untouched.
    for argument_index in "${!bridge_arguments[@]}"; do
        case ${bridge_arguments[argument_index]} in
            "$STEAM_ARM64_REMOVABLE_SOURCE")
                bridge_arguments[argument_index]=$STEAM_ARM64_REMOVABLE_TARGET
                ;;
            "$STEAM_ARM64_REMOVABLE_SOURCE"/*)
                argument_suffix=${bridge_arguments[argument_index]#"$STEAM_ARM64_REMOVABLE_SOURCE"}
                bridge_arguments[argument_index]=$STEAM_ARM64_REMOVABLE_TARGET$argument_suffix
                ;;
        esac
    done
fi

# proot-distro deliberately resets its guest environment. Preserve arbitrary
# Steam launch-option variables, but never inject the native glibc preload or
# candidate loader path into the Bionic route executable or container runtime.
while IFS= read -r -d '' entry; do
    name=${entry%%=*}
    [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    case $name in
        LD_PRELOAD|LD_LIBRARY_PATH|GLIBC_LD_LIBRARY_PATH|PATH|PREFIX|PWD|SHELL|\
        TGCOMPAT_*|PRESSURE_VESSEL_BWRAP)
            continue
            ;;
    esac
    pd_args+=(--env "$entry")
done < /proc/self/environ

guest_path=$compat_bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PREFIX/bin
pd_args+=(--env "HOME=$native_home")
pd_args+=(--env "PWD=$bridge_work_dir")
pd_args+=(--env "PATH=$guest_path")
pd_args+=(--env "LD_LIBRARY_PATH=$mesa_lib")
pd_args+=(--env "STEAM_ARM64_REAL_BWRAP=$real_bwrap")
pd_args+=(--env "STEAM_ARM64_PROC_NET=$proc_net")
pd_args+=(--env "STEAM_ARM64_HOST_VK_DRIVER_FILES=$host_vk_driver_files")
pd_args+=(--env "PROOT_L2S_EXDEV_PREFIX=$runtime_depot/var/tmp-")

case $bridge_mode in
    runtime)
        pd_args+=(--env "PRESSURE_VESSEL_BWRAP=$route")
        bridge_command=$runtime_depot/_v2-entry-point
        ;;
    bwrap)
        bridge_command=$route
        ;;
esac

# The bridge shell and Steam are glibc processes, while proot-distro and the
# route helper are Bionic. Remove glibc loader state at this one explicit ABI
# crossing; the game payload gets its runtime environment from Pressure Vessel.
unset LD_PRELOAD LD_LIBRARY_PATH GLIBC_LD_LIBRARY_PATH
unset TGCOMPAT_LD_SO TGCOMPAT_LIBRARY_PATH TGCOMPAT_EXEC_MATCH_INTERPRETER \
    TGCOMPAT_EXEC_LD_PRELOAD TGCOMPAT_EXEC_SHELL TGCOMPAT_EXEC_PATH_FROM \
    TGCOMPAT_EXEC_PATH_TO
export PATH=$custom_proot_dir:$PREFIX/bin:/system/bin
export PROOT_L2S_EXDEV_PREFIX=$runtime_depot/var/tmp-

# proot-distro applies its root login defaults after processing --env, which
# resets HOME to /root.  Set HOME again in the first guest-side executable so
# Proton's lsteamclient can resolve ~/.steam/sdkarm64/steamclient.so.
exec "$proot_distro" "${pd_args[@]}" -- \
    "$guest_env" "HOME=$native_home" "PWD=$bridge_work_dir" "$bridge_command" \
    "${bridge_arguments[@]}"
