diff --git a/src/path/path.c b/src/path/path.c
index d5c9ec6..4d953ee 100644
--- a/src/path/path.c
+++ b/src/path/path.c
@@ -29,6 +29,7 @@
 #include <sys/stat.h>  /* S_ISDIR, */
 #include <dirent.h>    /* opendir(3), readdir(3), */
 #include <stdio.h>     /* snprintf(3), */
+#include <stdlib.h>    /* getenv(3), */
 #include <errno.h>     /* E*, */
 #include <stddef.h>    /* ptrdiff_t, */
 #include <inttypes.h>  /* PRI*, */
@@ -339,6 +340,35 @@ int translate_path(Tracee *tracee, char result[PATH_MAX], int dir_fd,
 		if (result[0] != '/')
 			return -ENOTDIR;
 
+		/* Steam performs thousands of directory-relative fstatat(2)
+		 * calls with AT_SYMLINK_NOFOLLOW while scanning compatibility
+		 * tools.  For an explicitly trusted, host-visible tree, a
+		 * single-component final path cannot escape its directory and
+		 * does not require canonicalizing every parent component.
+		 *
+		 * Keep this opt-in: general guest paths still require normal
+		 * binding, symlink, and extension processing. */
+		{
+			const char *prefix = getenv("PROOT_NODEREF_FAST_PATH");
+			size_t prefix_length = prefix != NULL ? strlen(prefix) : 0;
+			bool under_prefix = prefix_length > 0
+				&& strncmp(result, prefix, prefix_length) == 0
+				&& (result[prefix_length] == '\0'
+					|| result[prefix_length] == '/');
+			bool simple_component = user_path[0] != '\0'
+				&& strchr(user_path, '/') == NULL
+				&& strcmp(user_path, ".") != 0
+				&& strcmp(user_path, "..") != 0;
+
+			if (!deref_final && under_prefix && simple_component) {
+				strcpy(guest_path, result);
+				status = join_paths(2, result, guest_path, user_path);
+				if (status < 0)
+					return status;
+				goto skip;
+			}
+		}
+
 		/* Remove the leading "root" part of the base
 		 * (required!). */
 		status = detranslate_path(tracee, result, NULL);
