+static void report_guest_crash(Tracee *tracee, int signal)
+{
+	if (getenv("PROOT_CRASH_LOG") == NULL)
+		return;
+
+	/* Signal stops do not necessarily have a fresh CURRENT register bank. */
+	(void) fetch_regs(tracee);
+	siginfo_t info = {};
+	(void) ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &info);
+	word_t ip = peek_reg(tracee, CURRENT, INSTR_POINTER);
+	word_t sp = peek_reg(tracee, CURRENT, STACK_POINTER);
+	fprintf(stderr,
+		"PROOT_CRASH pid=%d vpid=%" PRIu64 " signal=%d code=%d "
+		"fault=%p ip=%#lx sp=%#lx"
+#ifdef ARCH_ARM64
+		" lr=%#lx"
+#endif
+		" exe=%s\n",
+		tracee->pid, tracee->vpid, signal, info.si_code, info.si_addr,
+		(unsigned long) ip, (unsigned long) sp,
+#ifdef ARCH_ARM64
+		(unsigned long) tracee->_regs[CURRENT].regs[30],
+#endif
+		tracee->exe != NULL ? tracee->exe : "(unknown)");
+
+	char cmdline_path[64];
+	snprintf(cmdline_path, sizeof(cmdline_path), "/proc/%d/cmdline", tracee->pid);
+	FILE *cmdline = fopen(cmdline_path, "r");
+	if (cmdline != NULL) {
+		char command[4096];
+		size_t count = fread(command, 1, sizeof(command) - 1, cmdline);
+		fclose(cmdline);
+		for (size_t i = 0; i < count; i++)
+			if (command[i] == '\0') command[i] = ' ';
+		command[count] = '\0';
+		fprintf(stderr, "PROOT_CRASH cmdline=%s\n", command);
+	}
+
+	char maps_path[64];
+	snprintf(maps_path, sizeof(maps_path), "/proc/%d/maps", tracee->pid);
+	FILE *maps = fopen(maps_path, "r");
+	if (maps == NULL)
+		return;
+
+	char line[PATH_MAX + 160];
+	while (fgets(line, sizeof(line), maps) != NULL) {
+		unsigned long start, end;
+		if (sscanf(line, "%lx-%lx", &start, &end) == 2 &&
+			(unsigned long) ip >= start && (unsigned long) ip < end) {
+			fprintf(stderr, "PROOT_CRASH map=%s", line);
+			break;
+		}
+	}
+	fclose(maps);
